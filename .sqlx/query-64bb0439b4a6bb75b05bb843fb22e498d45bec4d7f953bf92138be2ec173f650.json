  "query": "SELECT\n    a.id,\n    a.task_id,\n    a.attempt_number,\n    a.worker_id,\n    a.fencing_token,\n    a.status,\n    a.lease_expires_at,\n    a.started_at,\n    a.finished_at,\n    a.error,\n    a.progress,\n    a.progress_updated_at\nFROM cloudiful_tasks.attempts AS a\nINNER JOIN cloudiful_tasks.tasks AS t ON t.id = a.task_id\nWHERE t.namespace = $1\n  AND t.queue = $2\n  AND a.task_id = $3\nORDER BY a.attempt_number DESC\nLIMIT $4\n",
