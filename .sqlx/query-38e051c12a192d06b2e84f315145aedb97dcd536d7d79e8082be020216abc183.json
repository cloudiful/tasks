{
  "db_name": "PostgreSQL",
  "query": "WITH candidate AS (\n    SELECT id, attempt_count\n    FROM cloudiful_tasks.tasks\n    WHERE namespace = $1\n      AND queue = $2\n      AND status = 'queued'\n      AND available_at <= clock_timestamp()\n    ORDER BY priority DESC, available_at, created_at, id\n    FOR UPDATE SKIP LOCKED\n    LIMIT 1\n),\nclaimed AS (\n    UPDATE cloudiful_tasks.tasks AS t\n    SET status = 'running',\n        attempt_count = t.attempt_count + 1,\n        updated_at = clock_timestamp()\n    FROM candidate AS c\n    WHERE t.id = c.id\n    RETURNING t.id\n),\nsealed_attempt AS (\n    INSERT INTO cloudiful_tasks.attempts (\n        id,\n        task_id,\n        attempt_number,\n        worker_id,\n        fencing_token,\n        status,\n        lease_expires_at,\n        started_at\n    )\n    SELECT $4, c.id, c.attempt_count + 1, $3, $5, 'running',\n           clock_timestamp() + ($6::bigint * interval '1 millisecond'), clock_timestamp()\n    FROM candidate AS c\n    RETURNING *\n)\nSELECT\n    attempt.id,\n    attempt.task_id,\n    attempt.attempt_number,\n    attempt.worker_id,\n    attempt.fencing_token,\n    attempt.status,\n    attempt.lease_expires_at,\n    attempt.started_at,\n    attempt.finished_at,\n    attempt.error,\n    attempt.progress,\n    attempt.progress_updated_at\nFROM sealed_attempt AS attempt\nINNER JOIN claimed ON claimed.id = attempt.task_id\n",
